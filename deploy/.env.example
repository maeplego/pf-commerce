# 開発モード（OIDC なし）では COMMERCE_DEV_AUTH=true のまま起動可
COMMERCE_DEV_AUTH=true
COMMERCE_CORS_ORIGIN=http://localhost:3009,http://localhost:3010,http://localhost:8110
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:8099
NEXT_PUBLIC_COMMERCE_BFF_URL=http://localhost:8110
COMMERCE_BFF_CORS_ORIGIN=http://localhost:3009

# OIDC（P01 pf-identity と併用。storefront に OIDC_ISSUER + OIDC_CLIENT_ID を渡すとログイン必須）
# COMMERCE_DEV_AUTH=false
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_AUDIENCE=pf-commerce-web
# OIDC_CLIENT_ID=pf-commerce-web
# OIDC_REDIRECT_URI=http://localhost:3009/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3009/logged-out
